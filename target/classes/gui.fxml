<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Torturi">
                <content>
                    <HBox spacing="10.0">
                        <VBox spacing="10.0" minWidth="200">
                            <Label text="ID Tort" />
                            <TextField fx:id="tortIdField" />
                            <Label text="Tip Tort" />
                            <TextField fx:id="tortTipField" />
                            <Button text="Adauga Tort" onAction="#btnAddTort" maxWidth="Infinity"/>
                            <Button text="Actualizeaza Tort" onAction="#btnUpdateTort" maxWidth="Infinity"/>
                            <Button text="Sterge Tort" onAction="#btnDeleteTort" maxWidth="Infinity"/>
                        </VBox>
                        <TableView fx:id="tortTable" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTortId" text="ID" prefWidth="50"/>
                                <TableColumn fx:id="colTortTip" text="Tip Tort" prefWidth="200"/>
                            </columns>
                        </TableView>
                    </HBox>
                </content>
            </Tab>

            <Tab text="Comenzi">
                <content>
                    <HBox spacing="10.0">
                        <VBox spacing="10.0" minWidth="200">
                            <Label text="ID Comanda" />
                            <TextField fx:id="comandaIdField" />
                            <Label text="ID-uri Torturi (ex: 1,2,3)" />
                            <TextField fx:id="comandaTorturiField" />
                            <Button text="Adauga Comanda" onAction="#btnAddComanda" maxWidth="Infinity"/>
                            <Button text="Actualizeaza Comanda" onAction="#btnUpdateComanda" maxWidth="Infinity"/>
                            <Button text="Sterge Comanda" onAction="#btnDeleteComanda" maxWidth="Infinity"/>
                        </VBox>
                        <TableView fx:id="comandaTable" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colComandaId" text="ID" prefWidth="50"/>
                                <TableColumn fx:id="colComandaData" text="Data" prefWidth="150"/>
                                <TableColumn fx:id="colComandaTorturi" text="Torturi" prefWidth="300"/>
                            </columns>
                        </TableView>
                    </HBox>
                </content>
            </Tab>

            <Tab text="Statistici">
                <content>
                    <VBox spacing="10">
                        <Label text="Statistici Rapide"/>
                        <HBox spacing="10" VBox.vgrow="ALWAYS">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Torturi pe Zi"/>
                                <ListView fx:id="statisticiZiList"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Torturi pe Luna"/>
                                <ListView fx:id="statisticiLunaList"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Top Torturi Comandate"/>
                                <ListView fx:id="statisticiTopList"/>
                            </VBox>
                        </HBox>
                        <Button text="Reincarca Statistici" onAction="#btnRefreshStats"/>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>